<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" href="images/logo.png" type="image/png">
    <title>Best Price Shop</title>
    <meta name="csrf-token" content="">
    <script src="https://cdn.jsdelivr.net/npm/vue@2.6.14/dist/vue.js"></script>
    <link rel="stylesheet" href="css/styles.css">
    <link rel="stylesheet" href="css/normalCards.css">
    <link rel="stylesheet" href="css/responsive.css">
</head>
<body>
<div id="app" class="body">
    <header class="slideDown">
        <div class="logo">
            <img src="images/logo.svg" alt="Best Price Shop">
        </div>
        <div class="message" >
            Hunt you price
        </div>
    </header>

    <div class="actions slideDown">
        <div class="search">
            <img src="images/search.svg" alt="search" v-on:click="search">
            <input type="hidden" ref="csrf" name="_csrf" value="<%= csrfToken %>" >
            <input type="text" id="search" placeholder="Trendy keyword" v-model="keyword" @keyup.enter="search">
            <button type="submit" v-on:click="search">search</button>
        </div>
        <div class="settings hide" v-on:click="filter">
            <img src="images/settings.svg" alt="Best Price Shop" >
        </div>
    </div>

    <div class="filter">
        <div class="sort">
            <span>Price</span>
            <div class="buttons">
                <button v-on:click="sortAscendant($event)">ascendant <img src="images/up.svg" alt="" width="10px"></button>
                <button v-on:click="sortDescendant($event)">descendant <img src="images/down.svg" alt="" width="10px"></button>
                <button v-on:click="sortRandom($event)">random</button>
            </div>
        </div>
        <div class="sites">
            <span>Source</span>
            <div class="buttons">
                <button v-on:click="sourceAmazon" >amazon</button>
                <button v-on:click="sourceFlipkart" >flipkart</button>
                <button>all</button>
            </div>
        </div>
    </div>
    <div class="faker" id="faker">
        <div class="found">
            Searching for products
        </div>
        <div class="card" v-for="index in 5" :key="index">
            <div class="image skeleton skeleton-image">
            </div>
            <div class="details">
                <div class="title">
                    <h2 class="skeleton skeleton-text"></h2>
                    <h3 class="skeleton skeleton-text"></h3>
                    <h3 class="skeleton skeleton-text"></h3>
                    <h3 class="skeleton skeleton-text"></h3>
                </div>
                <div class="price">
                    <h4 class="skeleton skeleton-text"></h4>
                </div>
            </div>
            <div class="source">
                <h5 class=" skeleton skeleton-text"></h5>
            </div>
        </div>
    </div>
    <main>
        <div class="found">
            Found <span> {{ results.length }} Results </span>
        </div>
        <div class="card" v-for="(product, index) in results" :key="product.id">
            <div class="image">
                <img :src="product.image" alt="Best Price Shop Product">
            </div>
            <div class="details">
                <a :href="product.link " class="title" target="_blank">
                    <h2>{{ product.title }}</h2>
                    <h3>{{ product.subtitle }}</h3>
                    <!-- <h3>subtitle</h3>-->
                </a>
                <div class="price">
                    <p>{{ product.price }}</p>
                </div>
            </div>
            <div class="source">
                <h5>{{ product.source }}</h5>
            </div>
        </div>

        <!-- no product found -->
        <div class="card not-found" v-if="results.length == 0">
            <h3>No Product found 🤔</h3>
            <h4>Please try again</h4>
            <h5>or other keywords</h5>
        </div>
    </main>
    
    <footer class="footerDown">
        Copyright - Made By BPS
    </footer>
</div>
    <script>
        var app = new Vue({
            el: '#app',
            data: {
                oldKeyword: '',
                keyword: '',
                results: [],
                rootResults: [],
                shown: false,
                filterShown: false,
            },

            methods: {
                search: function () {
                    if (!this.keyword.replace(/\s/g, '').length) {
                        return 0;
                    }

                    if(this.keyword == this.oldKeyword) {
                        return 0;
                    }
                    this.oldKeyword = this.keyword;

                    //hide title 
                    document.querySelector('main .found').style.opacity = 0;

                    //if new search
                    this.slideUp();
                    this.skeletonShow();

                    this.results = [];
                    var token = this.$refs.csrf.value;
                    console.log(token)
                    const requestOptions = {
                        method: "POST",
                        headers: {
                            'CSRF-Token': token,
                            'Content-Type': 'application/json',
                        },
                        body: JSON.stringify({ keyword: this.keyword })
                    };
                    fetch("/search", requestOptions)
                        .then(response => response.json())
                        .then(data => (this.rootResults = data))
                        .then(data => (this.results = this.rootResults))
                        .then(() => {
                            this.skeletonHide();
                            document.querySelector('main .found').style.opacity = 1;
                        });
                },
                slideUp: function () {
                    if(!this.shown) {
                        var header = document.getElementsByTagName('header')[0];
                        var actions = document.getElementsByClassName('actions')[0];
                        var main = document.getElementsByTagName('main')[0];
                        var footer = document.getElementsByTagName('footer')[0];
                        var notFound = document.querySelector('.not-found');
                        //show main 
                        //main.classList.add('show');
                        header.classList.remove('slideDown');
                        actions.classList.remove('slideDown');
                        footer.classList.remove('footerDown');
                        this.shown = true;
                    }
                },
                skeletonShow: function() {
                    const faker = document.querySelector('.faker')
                    const settings = document.querySelector('.settings')

                    faker.style.display = 'block';
                    settings.classList.remove('hide');
                    setTimeout(() => {
                        faker.classList.add('show');
                    }, 100);
                },
                skeletonHide: function() {
                    const faker = document.querySelector('.faker')
                    faker.style.display = 'none';
                    const main = document.getElementsByTagName('main')[0];
                    main.style.opacity = 1;
                },
                filter: function() {
                    const main = document.getElementsByTagName('main')[0];
                    const filter = document.querySelector('.filter')
                    const faker = document.querySelector('.faker')
                    
                    if(!this.filterShown) {
                        main.classList.add('show-filter');
                        filter.classList.add('show-filter');
                        faker.classList.add('show-filter');
                        this.filterShown = true;
                    } else {
                        main.classList.remove('show-filter')
                        filter.classList.remove('show-filter')
                        faker.classList.remove('show-filter')
                        this.filterShown = false;
                    }
                },
                sortAscendant: function(event) {
                    this.activeButtonFilter(event);

                    this.results = this.rootResults.slice().sort(function(a, b) {
                        return a.priceAmount - b.priceAmount;
                    });
                    console.log(this.results)
                },
                sortDescendant: function(event) {
                    this.activeButtonFilter(event);

                    this.results = this.rootResults.slice().sort(function(a, b) {
                        return b.priceAmount - a.priceAmount;
                    });
                    console.log(this.results)
                },
                sortRandom: function(event) {
                    this.activeButtonFilter(event);
                    
                    min = Math.ceil(0);
                    max = Math.floor(rootResults.length);

                    this.rootResults.forEach((item, index)=>{
                        item.order = Math.floor(Math.random() * (max - min) + min); 
                    });
                },
                sourceAmazon: function(event) {
                    this.activeButtonFilter(event);
                    this.results = this.filterSource('amazon');

                },
                sourceFlipkart: function(event) {
                    this.activeButtonFilter(event);
                    this.results = this.filterSource('flipkart');

                },
                sourceRandom: function(event) {
                    this.activeButtonFilter(event);

                },
                filterSource: function(source) {
                    var json = [];
                    this.rootResults.forEach((item) => {
                        if(item['source'] == source) {
                            json.push(item)
                        }
                    })
                    return json;
                },
                sourceDescendant: function() {

                },
                pagination: function(number) {

                },
                clearAllFilterButtonClass: function() {
                    //get filter
                    var filter = document.querySelector('.filter')
                    //count how many buttons container it got
                    var buttons = filter.querySelectorAll('.buttons')
                    var containerCount = buttons.length
                    //select first container of buttons
                    for(var i = 0; i < containerCount; i++) {
                        var buttonContainer = buttons[i];
                        var button = buttonContainer.getElementsByTagName('button');
                        var buttonCount = button.length;

                        for(var j = 0; j < buttonCount; j++) {
                            button[j].classList.remove('active')
                        }
                    }
                },
                activeButtonFilter: function(event) {
                    this.clearAllFilterButtonClass();

                    const selectedBtn = event.path[0];
                    selectedBtn.classList.add('active');

                }

            }
        })
    </script>
</body>
</html>