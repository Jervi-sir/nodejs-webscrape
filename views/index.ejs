<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <meta name="csrf-token" content="">
    <script src="https://cdn.jsdelivr.net/npm/vue@2.6.14/dist/vue.js"></script>
    <link rel="stylesheet" href="css/styles.css">
    <link rel="stylesheet" href="css/normalCards.css">
</head>
<body>
<div id="app">
    <header>
        <div class="logo">
            <img src="images/logo.svg" alt="">
        </div>
        <div class="message">
            Hunt you price
        </div>
    </header>

    <div class="actions">
        <div class="search">
            <img src="images/search.svg" alt="">
            <input type="hidden" ref="csrf" name="_csrf" value="<%= csrfToken %>" >
            <input type="text" id="search" placeholder="Search" v-model="keyword" @keyup.enter="search">
            <button type="submit" v-on:click="search">search</button>

        </div>
        <div class="settings">
            <img src="images/settings.svg" alt="">
        </div>
    </div>

    <main>
        <div class="found">
            Found <span> 10 Results </span>
        </div>
        <div class="card" v-for="(product, index) in results" :key="index">
            <div class="image">
                <img :src="product.image" alt="">
            </div>
            <div class="details">
                <div class="title">
                    <h2>{{ product.title }}</h2>
                    <h3>subtitle</h3>
                </div>
                <div class="price">
                    <h4>{{ product.price }}</h4>
                </div>
            </div>
            <div class="source">
                <h5>{{ product.source }}</h5>
            </div>
            <a href="{{ product.link }} "></a>

        </div>
    </main>
    <footer>
        Copyright - Made By BPS
    </footer>
    {{ results }}
</div>
    <script>
        var app = new Vue({
            el: '#app',
            data: {
                keyword: '',
                results: [],
            },

            methods: {
                search: function () {
                    var token = this.$refs.csrf.value;
                    console.log(token)
                    const requestOptions = {
                        method: "POST",
                        headers: {
                            'CSRF-Token': token,
                            'Content-Type': 'application/json',
                        },
                        body: JSON.stringify({ keyword: this.keyword })
                    };
                    fetch("/search", requestOptions)
                        .then(response => response.json())
                        .then(data => (this.results = data));
                }
            }
        })
    </script>
</body>
</html>